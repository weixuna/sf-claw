from building import *
import os

cwd = GetCurrentDir()
src = Glob('*.c')

group = DefineGroup('App_chat', src, depend=['PKG_USING_LITTLEVGL2RTT'],
                    CPPPATH=[cwd,
                             os.path.join(cwd, '..', '..', 'ui_bridge'),
                             os.path.join(cwd, '..', '..', 'wechat'),
                             os.path.join(cwd, '..', '..', '..', 'third_party',
                                          'rt-claw-port-sf32', 'include'),
                             os.path.join(cwd, '..', '..', '..', 'third_party',
                                          'rt-claw', 'include'),
                             os.path.join(cwd, '..', '..', '..', 'third_party',
                                          'rt-claw')],
                    LOCAL_CCFLAGS='')

Return('group')
